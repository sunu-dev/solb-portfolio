{
  "name": "solb-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "search:catalog": "node scripts/update-stock-catalog.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:ui": "node scripts/lint-ui.mjs",
    "lint:alerts": "node scripts/lint-alerts.mjs",
    "lint:korean": "node scripts/lint-korean.mjs",
    "lint:korean:soft": "node scripts/lint-korean.mjs --soft",
    "test": "vitest run",
    "test:tools": "node --test scripts/market-cause-health.test.cjs",
    "test:market-flow:history": "MARKET_FLOW_BACKTEST=1 vitest run scripts/market-flow-backtest.test.ts --reporter=verbose",
    "lint:darkmode": "node scripts/lint-darkmode.mjs",
    "lint:darkmode:soft": "node scripts/lint-darkmode.mjs --soft",
    "lint:tour-anchors": "node scripts/lint-tour-anchors.mjs",
    "prebuild": "npm run lint:ui && npm run lint:alerts && npm run lint:korean && npm run lint:darkmode && npm run lint:tour-anchors && npm test && npm run test:tools",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint:ui && npm run lint:alerts && npm run lint:korean && npm run lint:darkmode && npm run lint:tour-anchors && npm test && npm run test:tools",
    "check:public": "node scripts/check-public-flows.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@base-ui/react": "^1.3.0",
    "@google/genai": "^1.46.0",
    "@sentry/nextjs": "^10.75.2",
    "@supabase/supabase-js": "^2.99.3",
    "@upstash/qstash": "^2.10.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-pageflip": "^2.0.3",
    "resend": "^6.10.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "shadcn": "^4.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@sentry/bundler-plugins": {
      "glob": "14.0.2"
    },
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
